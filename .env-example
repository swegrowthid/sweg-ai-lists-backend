# Full Postgres URL (Supabase direct). Password stays inside the URL.
# Example: postgres://postgres:PASSWORD@db.xxx.supabase.co:5432/postgres?sslmode=require
DB_URL=

# JWT signing secret for HS256 tokens. REQUIRED - boot panics when empty.
# Generate: openssl rand -base64 32
JWT_SECRET=

# Token lifetimes as Go durations. Access 24h, refresh long.
JWT_ACCESS_TTL=24h
JWT_REFRESH_TTL=168h

# Scalar docs UI at /docs. Default: on outside prod, off in prod.
# Set DOCS_UI=1 to enable in prod, DOCS_UI=0 to force off.
DOCS_UI=

# Comma-separated browser origins allowed cross-site (CORS). Empty = none.
# Prod example: CORS_ORIGINS=https://ai-sweg.my.id
# Local dev against astro dev server: CORS_ORIGINS=http://localhost:4321
CORS_ORIGINS=

# Magic link email login via SMTP. Connection is implicit TLS (SSL), as on
# port 465. Auth is PLAIN. Example: smtp.sumopod.com:465.
# Empty SMTP_HOST in dev logs links via LogMailer; empty in prod panics at boot.
# SMTP_PASSWORD is read verbatim: do not wrap it in quotes or add spaces.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=swegai <noreply@ai-sweg.my.id>
MAGIC_LINK_TTL=15m
MAGIC_LINK_BASE_URL=https://ai-sweg.my.id/login/magic

# Run app:        make run
# Migrate up:     make migrate-up
# Migrate status: make migrate-status
# Migrate down:   make migrate-down